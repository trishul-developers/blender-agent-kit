{
  "name": "supplycrate-trial",
  "version": "1.0.0",
  "description": "Independent trial profile for SupplyCrate prop review and QA.",
  "target_overrides": {
    "unity": {
      "qa": {
        "common": {
          "lod_exclude_patterns": ["*_COL_*"]
        }
      }
    }
  },
  "review_presets": {
    "showcase_tiles": {
      "resolution": [960, 540],
      "orthographic_views": ["front", "side", "rear", "top"],
