{
  "name": "realtime-default",
  "version": "1.1.0",
  "description": "Reusable real-time asset production policy. These are Blender Agent Kit defaults, not engine requirements.",
  "target_defaults": {
    "naming": {
      "lod_pattern": "{name}_LOD{index}",
      "collider_patterns": [
        "{name}_COL_{index:02d}",
        "COLLISION_{name}"
      ]
    },
    "export": {
      "prebake_directional_patterns": [
        "Socket_*"
      ],
      "strip_lod_suffix_pattern": "_LOD[0-9]+$",
      "lod_screen_transitions": {
        "0": 0.5,
        "1": 0.2,
        "2": 0.05,
        "3": 0.01
      }
    },
    "qa": {
      "common": {
        "require_applied_scale": true,
        "reject_negative_scale": true,
        "reject_non_manifold_edges": true,
        "reject_inward_normals": true,
        "require_uv0": true,
        "require_monotonic_lod_tris": true,
        "texel_density_px_per_m": [
          256,
          1024
        ]
      },
      "asset_classes": {
        "solid_prop": {
          "reject_boundary_edges": true,
          "require_non_overlapping_uv1": true,
          "pivot_rule": "bottom_center_z0",
          "max_tris": {
            "lod0": 15000,
            "lod1": 7500,
            "lod2": 3000
          },
          "max_material_slots": 2
        },
        "open_sheet": {
          "reject_boundary_edges": false,
          "require_non_overlapping_uv1": false,
          "pivot_rule": "none",
          "max_tris": {
            "lod0": 10000
          },
          "max_material_slots": 2
        },
        "skinned_character": {
          "reject_boundary_edges": false,
          "require_non_overlapping_uv1": false,
          "max_bone_weights_per_vertex": 4,
          "pivot_rule": "bottom_center_z0",
          "max_tris": {
            "lod0": 60000,
            "lod1": 30000,
            "lod2": 12000
          },
          "max_material_slots": 4
        }
      }
    },
    "review": {
      "default_style": "technical",
      "styles": {
        "technical": {
          "engine": "BLENDER_EEVEE",
          "resolution": [
            960,
            540
          ],
          "samples": 8,
          "background_color": [
            0.18,
            0.19,
            0.2,
            1
          ],
          "background_strength": 0.8,
          "hero_distance_factor": 2.25,
          "hero_min_distance_m": 1,
          "hero_height_factor": 0.45,
          "hero_lens_mm": 58,
          "ortho_scale_factor": 2.2,
          "lighting": {
            "use_authored_lights": false,
            "reference_radius_m": 2.5,
            "area_size_factor": 0.85,
            "min_area_size_m": 0.25,
            "lights": [
              {
                "name": "QA_Key",
                "direction": [
                  1.4,
                  -1.5,
                  1.7
                ],
                "energy": 1100
              },
              {
                "name": "QA_Fill",
                "direction": [
                  -1.3,
                  -0.8,
                  1.1
                ],
                "energy": 750
              },
              {
                "name": "QA_Rim",
                "direction": [
                  0.4,
                  1.7,
                  1.5
                ],
                "energy": 950
              }
            ]
          }
        },
        "showcase": {
          "engine": "CYCLES",
          "resolution": [
            1280,
            720
          ],
          "samples": 64,
          "background_color": [
            0.025,
            0.03,
            0.04,
            1
          ],
          "background_strength": 0.35,
          "hero_distance_factor": 2.05,
          "hero_min_distance_m": 1.2,
          "hero_height_factor": 0.55,
          "hero_lens_mm": 62,
          "ortho_scale_factor": 2.15,
          "lighting": {
            "use_authored_lights": false,
            "reference_radius_m": 2.5,
            "area_size_factor": 0.9,
            "min_area_size_m": 0.25,
            "lights": [
              {
                "name": "QA_Key",
                "direction": [
                  1.5,
                  -1.5,
                  1.8
                ],
                "energy": 1250
              },
              {
                "name": "QA_Fill",
                "direction": [
                  -1.5,
                  -0.7,
                  1
                ],
                "energy": 600
              },
              {
                "name": "QA_Rim",
                "direction": [
                  0.3,
                  1.8,
                  1.4
                ],
                "energy": 1050
              }
            ]
          }
        }
      }
    }
  }
}
