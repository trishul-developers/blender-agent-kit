{
  "name": "unity",
  "skill_name": "blender-target-unity",
  "version": "1.3.0",
  "default_profile": "urp",
  "units": {
    "system": "METRIC",
    "scale": 1
  },
  "export": {
    "format": "fbx",
    "alt_static_format": "glb",
    "use_selection": true,
    "object_types": [
      "MESH",
      "EMPTY",
      "ARMATURE"
    ],
    "forward_axis": "-Z",
    "up_axis": "Y",
    "apply_scalings": "FBX_SCALE_ALL",
    "apply_unit_scale": true,
    "use_space_transform": false,
    "prebake_yup_hierarchy": true,
    "strip_lod_suffix_on_export": false,
    "apply_transform_static": false,
    "apply_transform_rigged": false,
    "apply_modifiers": true,
    "use_triangles": true,
    "use_tspace": true,
    "mesh_smooth_type": "FACE",
    "only_deform_bones": true,
    "add_leaf_bones": false,
    "bake_anim": true,
    "bake_anim_use_nla_strips": true,
    "bake_anim_use_all_actions": false,
    "bake_anim_simplify_factor": 0,
    "embed_textures": false
  },
  "naming": {
    "texture_pattern": "textures/{asset_id}__{material_name}__{map}.png",
    "manifest_file": "{name}.asset.manifest.json"
  },
  "textures": {
    "normal_convention": "opengl",
    "fallback_constants": {
      "ao": 1,
      "alpha": 1,
      "metallic": 0,
      "roughness": 0.5,
      "detail_mask": 0
    },
    "profiles": {
      "urp": {
        "shader": "Universal Render Pipeline/Lit",
        "maps": {
          "albedo": {
            "unity_slot": "_BaseMap",
            "channels": [
              "base_color.r",
              "base_color.g",
              "base_color.b",
              "alpha"
            ],
            "srgb": true,
            "bit_depth": 8,
            "unity_type": "Default"
          },
          "metallic_smoothness": {
            "unity_slot": "_MetallicGlossMap",
            "channels": [
              "metallic",
              "metallic",
              "metallic",
              "1-roughness"
            ],
            "srgb": false,
            "bit_depth": 8,
            "unity_type": "Default",
            "unpremultiplied_rgba": true
          },
          "normal": {
            "unity_slot": "_BumpMap",
            "channels": [
              "normal.r",
              "normal.g",
              "normal.b"
            ],
            "srgb": false,
            "bit_depth": 16,
            "unity_type": "NormalMap"
          },
          "ao": {
            "unity_slot": "_OcclusionMap",
            "channels": [
              "ao"
            ],
            "srgb": false,
            "bit_depth": 8,
            "unity_type": "Default"
          },
          "emission": {
            "unity_slot": "_EmissionMap",
            "channels": [
              "emission.r",
              "emission.g",
              "emission.b"
            ],
            "srgb": true,
            "bit_depth": 8,
            "unity_type": "Default",
            "optional": true
          }
        }
      },
      "hdrp": {
        "shader": "HDRP/Lit",
        "maps": {
          "base_map": {
            "unity_slot": "_BaseColorMap",
            "channels": [
              "base_color.r",
              "base_color.g",
              "base_color.b",
              "alpha"
            ],
            "srgb": true,
            "bit_depth": 8,
            "unity_type": "Default"
          },
          "mask_map": {
            "unity_slot": "_MaskMap",
            "channels": [
              "metallic",
              "ao",
              "detail_mask",
              "1-roughness"
            ],
            "srgb": false,
            "bit_depth": 8,
            "unity_type": "Default",
            "unpremultiplied_rgba": true
          },
          "normal": {
            "unity_slot": "_NormalMap",
            "channels": [
              "normal.r",
              "normal.g",
              "normal.b"
            ],
            "srgb": false,
            "bit_depth": 16,
            "unity_type": "NormalMap"
          },
          "emission": {
            "unity_slot": "_EmissiveColorMap",
            "channels": [
              "emission.r",
              "emission.g",
              "emission.b"
            ],
            "srgb": true,
            "bit_depth": 8,
            "unity_type": "Default",
            "optional": true
          }
        }
      }
    }
  },
  "qa": {
    "common": {
      "roundtrip_armature_scale_tolerance": 0.001
    },
    "asset_classes": {}
  },
  "default_policy": "realtime-default"
}
