{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trishul-developers/blender-skills/schemas/project-profile.schema.json",
  "title": "Blender Agent Kit Project Profile",
  "type": "object",
  "required": ["name", "version", "target_overrides"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "target_overrides": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "bundle_defaults": { "type": "object" }
  }
}
