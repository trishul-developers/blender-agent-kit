{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trishul-developers/blender-agent-kit/schemas/capabilities.schema.json",
  "title": "Blender Agent Kit Capabilities",
  "type": "object",
  "required": [
    "status",
    "kit_version",
    "runtime",
    "commands",
    "targets",
    "policies",
    "project_profiles",
    "skills",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "ok"
    },
    "kit_version": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "required": [
        "host_python",
        "blender",
        "headless_first"
      ],
      "properties": {
        "host_python": {
          "type": "string"
        },
        "blender": {
          "type": "string"
        },
        "headless_first": {
          "type": "boolean"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mode",
          "skill",
          "purpose",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "host",
              "blender"
            ]
          },
          "skill": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "texture_profiles"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "texture_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "project_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "targets",
          "review_presets"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_presets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "execution",
          "commands"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "execution": {
            "enum": [
              "executable",
              "executable-config",
              "configuration",
              "guidance-only"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "object"
    }
  }
}
