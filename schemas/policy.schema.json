{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trishul-developers/blender-agent-kit/schemas/policy.schema.json",
  "title": "Blender Agent Kit Production Policy",
  "type": "object",
  "required": [
    "name",
    "version",
    "target_defaults"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "target_defaults": {
      "type": "object"
    },
    "target_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
