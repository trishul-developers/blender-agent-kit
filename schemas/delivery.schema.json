{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trishul-developers/blender-agent-kit/schemas/delivery.schema.json",
  "title": "Blender Agent Kit Delivery Report",
  "type": "object",
  "required": [
    "status",
    "stages"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "failed_stage": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "artifacts_root": {
      "type": "string"
    },
    "qa_gate": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "override_used": {
          "type": "boolean"
        },
        "expensive_stages_skipped": {
          "type": "boolean"
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "recommended_from": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "duration_ms",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "gate_passed": {
            "type": "boolean"
          },
          "result": {
            "type": "object"
          }
        }
      }
    }
  }
}
