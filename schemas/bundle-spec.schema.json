{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trishul-developers/blender-skills/schemas/bundle-spec.schema.json",
  "title": "Blender Agent Kit Semantic Bundle Export Spec",
  "type": "object",
  "required": ["schema_version", "asset_id", "parts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "asset_id": { "type": "string", "minLength": 1 },
    "build_inputs": { "type": "array", "items": { "type": "string" } },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "lod": { "type": ["integer", "null"], "minimum": 0 },
          "collection": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["fbx", "glb", "gltf"] }
        },
        "oneOf": [
          { "required": ["collection"], "not": { "required": ["root"] } },
          { "required": ["root"], "not": { "required": ["collection"] } }
        ]
      }
    }
  }
}
